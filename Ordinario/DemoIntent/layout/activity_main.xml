<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="265dp"
        android:layout_height="37dp"
        android:layout_marginBottom="16dp"
        android:text="Demo de Intents y Extras"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/etEdad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Edad"
        android:inputType="number" />

    <CheckBox
        android:id="@+id/cbEstudiante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Soy estudiante" />

    <EditText
        android:id="@+id/etNum1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Número 1"
        android:inputType="numberSigned" />

    <EditText
        android:id="@+id/etNum2"
        android:layout_width="362dp"
        android:layout_height="47dp"
        android:hint="Número 2"
        android:inputType="numberSigned" />

    <Button
        android:id="@+id/btnSaludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="1. Saludar" />

    <Button
        android:id="@+id/btnSuma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Sumar" />

    <Button
        android:id="@+id/btnPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Ver perfil" />

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Aquí aparecerá la respuesta de PerfilActivity"
        android:textSize="16sp" />
</LinearLayout>