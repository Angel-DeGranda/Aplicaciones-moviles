<?xml version="1.0" encoding="utf-8"?>
<!-- Fase 12: la sesión (tokens de Supabase) y el token FCM NO se respaldan
     ni se pasan a otro teléfono. (Android 12 o más nuevo) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesion.xml" />
        <exclude domain="sharedpref" path="fcm.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesion.xml" />
        <exclude domain="sharedpref" path="fcm.xml" />
    </device-transfer>
</data-extraction-rules>
